{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-factory.example/contracts/2.2/narrative.schema.json",
  "title": "P2 fixed-cut scene, text, extraction and world reconciliation contracts",
  "$defs": {
    "StateCheck": {
      "type": "object",
      "properties": {
        "check_id": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
        },
        "plane": {
          "enum": [
            "WORLD",
            "BELIEF"
          ]
        },
        "subject_id": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "at": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/StoryPoint"
        },
        "expected_status": {
          "enum": [
            "VALUE",
            "NONE",
            "NOT_APPLICABLE"
          ]
        },
        "expected_value": {
          "oneOf": [
            {
              "oneOf": [
                {
                  "$ref": "https://novel-factory.example/contracts/2.1/temporal_concurrency.schema.json#/$defs/RelationValue"
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "RESOURCE_BALANCE"
                    },
                    "account_id": {
                      "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
                    },
                    "resource_id": {
                      "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
                    },
                    "quantity": {
                      "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/Decimal"
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 10000
                    }
                  },
                  "required": [
                    "kind",
                    "account_id",
                    "resource_id",
                    "quantity",
                    "unit"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "actor_id": {
          "oneOf": [
            {
              "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "known_at": {
          "oneOf": [
            {
              "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/StoryPoint"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "check_id",
        "plane",
        "subject_id",
        "predicate",
        "at",
        "expected_status",
        "expected_value",
        "actor_id",
        "known_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "plane": {
                "const": "BELIEF"
              }
            }
          },
          "then": {
            "properties": {
              "actor_id": {
                "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
              },
              "known_at": {
                "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/StoryPoint"
              }
            }
          },
          "else": {
            "properties": {
              "actor_id": {
                "type": "null"
              },
              "known_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expected_status": {
                "const": "VALUE"
              }
            }
          },
          "then": {
            "properties": {
              "expected_value": {
                "oneOf": [
                  {
                    "$ref": "https://novel-factory.example/contracts/2.1/temporal_concurrency.schema.json#/$defs/RelationValue"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "RESOURCE_BALANCE"
                      },
                      "account_id": {
                        "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
                      },
                      "resource_id": {
                        "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
                      },
                      "quantity": {
                        "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/Decimal"
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 10000
                      }
                    },
                    "required": [
                      "kind",
                      "account_id",
                      "resource_id",
                      "quantity",
                      "unit"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "expected_value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "KnowledgeUse": {
      "type": "object",
      "properties": {
        "actor_id": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
        },
        "subject_id": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "at": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/StoryPoint"
        },
        "mode": {
          "enum": [
            "KNOWS",
            "BELIEVES",
            "SAYS",
            "GUESSES"
          ]
        },
        "value": {
          "oneOf": [
            {
              "$ref": "https://novel-factory.example/contracts/2.1/temporal_concurrency.schema.json#/$defs/RelationValue"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "RESOURCE_BALANCE"
                },
                "account_id": {
                  "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
                },
                "resource_id": {
                  "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
                },
                "quantity": {
                  "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/Decimal"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                }
              },
              "required": [
                "kind",
                "account_id",
                "resource_id",
                "quantity",
                "unit"
              ],
              "additionalProperties": false
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/EvidenceRef"
          },
          "minItems": 0,
          "maxItems": 50
        }
      },
      "required": [
        "actor_id",
        "subject_id",
        "predicate",
        "at",
        "mode",
        "value",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "AssertionCandidate": {
      "type": "object",
      "properties": {
        "assertion_id": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
        },
        "classification": {
          "enum": [
            "EXISTING_EVENT_PRESENTATION",
            "SURFACE_DETAIL",
            "SPEECH_OR_BELIEF",
            "ATTRIBUTED_STATEMENT",
            "NEW_WORLD_EFFECT",
            "HISTORICAL_CONFLICT",
            "READER_DISCLOSURE_CHANGE",
            "UNCERTAIN"
          ]
        },
        "span": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/TextSpan"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "event_ref": {
          "oneOf": [
            {
              "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/EventRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "world_check": {
          "oneOf": [
            {
              "$ref": "#/$defs/StateCheck"
            },
            {
              "type": "null"
            }
          ]
        },
        "knowledge_use": {
          "oneOf": [
            {
              "$ref": "#/$defs/KnowledgeUse"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposed_command": {
          "oneOf": [
            {
              "$ref": "https://novel-factory.example/contracts/p1/commands.schema.json#/$defs/TemplateCommand"
            },
            {
              "type": "null"
            }
          ]
        },
        "disclosure_id": {
          "oneOf": [
            {
              "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "declared_delta_index": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "assertion_id",
        "classification",
        "span",
        "summary",
        "event_ref",
        "world_check",
        "knowledge_use",
        "proposed_command",
        "disclosure_id",
        "declared_delta_index"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "const": "ATTRIBUTED_STATEMENT"
              }
            }
          },
          "then": {
            "description": "Only an attributed saying, inference or displayed message in this exact draft; not a world truth, accepted speech occurrence, persistent belief, disclosure or effect. Requires independent current-draft epistemic evidence verified by the application, never a model-supplied permission.",
            "properties": {
              "event_ref": {"type": "null"},
              "world_check": {"type": "null"},
              "knowledge_use": {"type": "null"},
              "proposed_command": {"type": "null"},
              "disclosure_id": {"type": "null"},
              "declared_delta_index": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "EXISTING_EVENT_PRESENTATION"
              }
            }
          },
          "then": {
            "properties": {
              "event_ref": {
                "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/EventRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "NEW_WORLD_EFFECT"
              }
            }
          },
          "then": {
            "properties": {
              "proposed_command": {
                "$ref": "https://novel-factory.example/contracts/p1/commands.schema.json#/$defs/TemplateCommand"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "SURFACE_DETAIL"
              }
            }
          },
          "then": {
            "properties": {
              "event_ref": {
                "type": "null"
              },
              "world_check": {
                "type": "null"
              },
              "knowledge_use": {
                "type": "null"
              },
              "proposed_command": {
                "type": "null"
              },
              "disclosure_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "ScenePlan": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.2"
        },
        "scene_contract": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/SceneContract"
        },
        "plan_ref": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/ArtifactRef"
        },
        "plan_node_ids": {
          "type": "array",
          "items": {
            "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
          },
          "minItems": 1,
          "maxItems": 200
        },
        "batch_ref": {
          "oneOf": [
            {
              "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "prior_scene_ref": {
          "oneOf": [
            {
              "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_event_refs": {
          "type": "array",
          "items": {
            "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/EventRef"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "required_predecessor_scene_ids": {
          "type": "array",
          "items": {
            "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "entry_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StateCheck"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "exit_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StateCheck"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "allowed_disclosures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AllowedDisclosure"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "literary_purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "scene_contract_ref": {
          "oneOf": [
            {
              "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "scene_contract",
        "plan_ref",
        "plan_node_ids",
        "batch_ref",
        "prior_scene_ref",
        "required_event_refs",
        "required_predecessor_scene_ids",
        "entry_checks",
        "exit_checks",
        "allowed_disclosures",
        "literary_purpose",
        "scene_contract_ref"
      ],
      "additionalProperties": false
    },
    "DraftRecord": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.2"
        },
        "draft_id": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
        },
        "scene_ref": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/ArtifactRef"
        },
        "text_ref": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/ArtifactRef"
        },
        "input_world_ref": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/WorldRef"
        },
        "task_id": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "context_bundle_id": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
        },
        "prior_draft_ref": {
          "oneOf": [
            {
              "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "declared_important_deltas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "minItems": 0,
          "maxItems": 100
        },
        "handoff_refs": {
          "type": "array",
          "items": {
            "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/ArtifactRef"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "agent_output_ref": {
          "oneOf": [
            {
              "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "draft_id",
        "scene_ref",
        "text_ref",
        "input_world_ref",
        "task_id",
        "generation",
        "context_bundle_id",
        "prior_draft_ref",
        "title",
        "declared_important_deltas",
        "handoff_refs",
        "agent_output_ref"
      ],
      "additionalProperties": false
    },
    "TextDelivery": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.2"
        },
        "task_id": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "context_bundle_id": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
        },
        "draft_ref": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/ArtifactRef"
        },
        "text_ref": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/ArtifactRef"
        },
        "scene_ref": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/ArtifactRef"
        },
        "world_ref": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/WorldRef"
        },
        "span": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/TextSpan"
        },
        "read_mode": {
          "enum": [
            "FULL_TEXT",
            "EXCERPT"
          ]
        },
        "delivery_semantics": {
          "const": "EXACT_BYTES_OFFERED_NOT_UNDERSTANDING"
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "generation",
        "context_bundle_id",
        "draft_ref",
        "text_ref",
        "scene_ref",
        "world_ref",
        "span",
        "read_mode",
        "delivery_semantics"
      ],
      "additionalProperties": false
    },
    "ExtractionRecord": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.2"
        },
        "extraction_id": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
        },
        "draft_ref": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/ArtifactRef"
        },
        "text_ref": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/ArtifactRef"
        },
        "scene_ref": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/ArtifactRef"
        },
        "task_id": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "context_bundle_id": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
        },
        "delivery_ref": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/ArtifactRef"
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssertionCandidate"
          },
          "minItems": 0,
          "maxItems": 500
        },
        "coverage": {
          "const": "FULL_TEXT_DELIVERED"
        },
        "semantic_completeness": {
          "const": "REQUIRES_INDEPENDENT_REVIEW"
        }
      },
      "required": [
        "schema_version",
        "extraction_id",
        "draft_ref",
        "text_ref",
        "scene_ref",
        "task_id",
        "generation",
        "context_bundle_id",
        "delivery_ref",
        "assertions",
        "coverage",
        "semantic_completeness"
      ],
      "additionalProperties": false
    },
    "NarrativeDelta": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.2"
        },
        "delta_id": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
        },
        "draft_ref": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/ArtifactRef"
        },
        "assertion_id": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
        },
        "input_world_ref": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/WorldRef"
        },
        "proposed_command": {
          "$ref": "https://novel-factory.example/contracts/p1/commands.schema.json#/$defs/TemplateCommand"
        },
        "source_span": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/TextSpan"
        },
        "status": {
          "const": "PENDING_WORLD_REVIEW"
        },
        "world_effects_applied": {
          "const": 0
        }
      },
      "required": [
        "schema_version",
        "delta_id",
        "draft_ref",
        "assertion_id",
        "input_world_ref",
        "proposed_command",
        "source_span",
        "status",
        "world_effects_applied"
      ],
      "additionalProperties": false
    },
    "Resolution": {
      "type": "object",
      "properties": {
        "assertion_id": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
        },
        "event_ref": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/EventRef"
        }
      },
      "required": [
        "assertion_id",
        "event_ref"
      ],
      "additionalProperties": false
    },
    "ReconciliationReport": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.2"
        },
        "report_id": {
