{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-factory.example/contracts/2.2/release.schema.json",
  "title": "P2 fixed snapshot writing batches and internal release records",
  "description": "Server-issued batches, task handoffs and local release records. The immutable core 2.0 ReleaseManifest remains unchanged. No object in this schema grants world write authority or performs external delivery.",
  "$defs": {
    "SceneSlot": {
      "type": "object",
      "properties": {
        "scene_id": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
        },
        "story_interval": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/StoryInterval"
        },
        "reader_cut_ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "required_predecessor_scene_ids": {
          "type": "array",
          "items": {
            "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "required": [
        "scene_id",
        "story_interval",
        "reader_cut_ordinal",
        "required_predecessor_scene_ids"
      ],
      "additionalProperties": false
    },
    "WritingBatchRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.2"
        },
