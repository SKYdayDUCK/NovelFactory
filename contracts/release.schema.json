          "items": {
            "$ref": "#/$defs/SceneSlot"
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "batch_id": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
        },
        "created_by": {
          "$ref": "https://novel-factory.example/contracts/2.0/core.schema.json#/$defs/UUID"
