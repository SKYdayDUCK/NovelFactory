[Unit]
Description=NovelFactory P6 production for book %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=novelfactory
Group=novelfactory
WorkingDirectory=/srv/novelfactory
EnvironmentFile=/etc/novelfactory/p6-production.env
ExecStart=/srv/novelfactory/.venv/bin/python /srv/novelfactory/scripts/p6_batch.py worker --private-dir ${NF_P6_BATCH_DIR} --book %i
Restart=on-failure
RestartPreventExitStatus=3
RestartSec=10
TimeoutStopSec=330
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/novelfactory

[Install]
WantedBy=multi-user.target
