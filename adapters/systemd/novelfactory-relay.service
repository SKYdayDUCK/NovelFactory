[Unit]
Description=NovelFactory PostgreSQL outbox relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=novelfactory
Group=novelfactory
WorkingDirectory=/srv/novelfactory
EnvironmentFile=/etc/novelfactory/relay.env
ExecStart=/srv/novelfactory/.venv/bin/python /srv/novelfactory/scripts/run_eventhub.py relay
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/novelfactory

[Install]
WantedBy=multi-user.target
