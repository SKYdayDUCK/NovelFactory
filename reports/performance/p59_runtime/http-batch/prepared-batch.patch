@@ -287,3 +287,56 @@ def test_http_query_checks_its_full_contract_once_and_keeps_direct_call_validati
     first = prepared.materialize()
     first['query'].clear()
     assert prepared.materialize() == client['request']
+
+
+def test_batch_contract_validation_and_ownership_across_entry_points(service_env, service_world, monkeypatch):
+    from novel_factory.application import queries
+    from novel_factory.domain.errors import DomainError
+    from novel_factory.interfaces import http as transport
+
+    client = make_client(service_env, service_world, actor=True)
+    single = client["request"]
+    batch = {key: single[key] for key in ("schema_version", "task_id", "generation", "read_contract", "knowledge_cut")}
+    batch["items"] = [{"item_id": "a", **{key: single[key] for key in ("subject_time", "query", "page_size")}}]
+    validations = []
+
+    def counted(name, value, version="2.0"):
+        if name == "QueryBatchRequest":
+            validations.append(name)
+        return validate_contract(name, value, version)
+
+    monkeypatch.setattr(queries, "validate_contract", counted)
+    monkeypatch.setattr(transport, "validate_contract", counted)
+    app = create_app(service_env["kernel"])
+    invalid = {**batch, "unknown": True}
+    with loopback_server(app) as url, httpx.Client(base_url=url, trust_env=False) as http:
+        result = http.post("/api/v1/queries/batch", json=batch, headers=headers(client))
+        assert result.status_code == 200 and len(validations) == 1
+        assert result.json()["items"][0]["payload"] == client["expected_payload"]
+        assert http.post("/api/v1/queries/batch", json=invalid).status_code == 422
+        assert http.post("/api/v1/queries/batch", json=batch).status_code == 401
+        service_env["kernel"].revoke_grant(service_world["principal"], client["principal"].grant_id)
+        assert http.post("/api/v1/queries/batch", json=batch, headers=headers(client)).status_code == 401
+
+    with pytest.raises(DomainError) as failure:
+        app.state.query_service.batch(None, invalid)
+    assert failure.value.code == "INVALID_ARGUMENT"
+    source = deepcopy(batch)
+    prepared = queries.PreparedQueryBatch(source)
+    source["items"].clear()
+    first = prepared.materialize()
+    first["items"][0]["query"].clear()
+    assert prepared.materialize() == batch
+
+    class CustomQueries:
+        def batch(self, principal, request):
+            assert type(request) is dict
+            request["items"].clear()
+            return {"status": "fixture received mutable dict"}
+
+    other = make_client(service_env, service_world, actor=True)
+    custom_app = create_app(service_env["kernel"], query_service=CustomQueries())
+    with loopback_server(custom_app) as url, httpx.Client(base_url=url, trust_env=False) as http:
+        received = http.post("/api/v1/queries/batch", json=batch, headers=headers(other))
+        assert received.json() == {"status": "fixture received mutable dict"}
+        assert http.post("/api/v1/queries/batch", json=invalid).status_code == 422
