+_FENCED_STATUS = text("""
+    WITH locked_work AS MATERIALIZED (
+        SELECT t.*, i.spec->'world_ref' AS world_ref, w.work_id AS fenced_work
+        FROM nf_tasks t JOIN nf_works w ON w.work_id=t.work_id
+        LEFT JOIN nf_task_inputs i ON (i.task_id, i.generation)=(t.task_id, t.generation)
+        WHERE t.task_id=:task_id FOR SHARE OF w
+    )
+    SELECT s.*, g.grant_id::text AS authorized_grant, g.principal_id::text AS authorized_principal,
+           g.work_id::text AS authorized_work, g.active, g.role_id AS authorized_role,
+           g.capabilities, g.branch_ids
+    FROM locked_work s
+    LEFT JOIN LATERAL (
+        SELECT g.* FROM nf_grants g
+        WHERE g.grant_id=:grant_id AND g.work_id=s.fenced_work FOR SHARE OF g
+    ) g ON true
+""")
+
