+    def status_with_locked_grant(self, task_id, grant_id):
+        row = self.conn.execute(_FENCED_STATUS, {"task_id": task_id, "grant_id": grant_id}).mappings().one_or_none()
+        if row is None:
+            return None, None, None
+        task = {column.key: row[column.key] for column in self.tables["tasks"].c}
+        # Untyped text() bypasses the UUID(as_uuid=False) adapter.
+        from uuid import UUID
+        task = {name: str(value) if isinstance(value, UUID) else value for name, value in task.items()}
+        grant = {
+            "grant_id": row["authorized_grant"], "principal_id": row["authorized_principal"],
+            "work_id": row["authorized_work"], "active": row["active"], "role_id": row["authorized_role"],
+            "capabilities": row["capabilities"], "branch_ids": row["branch_ids"],
+        }
+        return task, grant, row["world_ref"]
