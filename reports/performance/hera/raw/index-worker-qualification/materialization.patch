+    @staticmethod
+    def _advance_watermarks(repo, wr, branch_seq):
+        # The caller holds this branch's UPDATE lock. Read both generations
+        # together, preserving the equal-sequence corruption check for each.
+        current = {row["index_name"]: row for row in repo.many("index_watermarks", {
+            "branch_id": wr["branch_id"], "index_name": INDEX_NAMES,
+        })}
+        advance = []
+        for name in INDEX_NAMES:
+            previous = current.get(name)
+            if previous and previous["branch_seq"] == branch_seq:
+                require(previous["world_revision_id"] == wr["world_revision_id"],
+                        "PROJECTION_CORRUPT", "The same branch sequence cannot identify two world revisions")
+            if previous is None or previous["branch_seq"] < branch_seq:
+                advance.append(name)
+        if advance:
+            repo.conn.execute(text("""
+                INSERT INTO nf_index_watermarks AS w
+                    (branch_id, index_name, world_revision_id, branch_seq, generation)
+                SELECT :branch_id, name, :world_revision_id, :seq, 1
+                FROM unnest(CAST(:names AS text[])) AS entries(name)
+                ON CONFLICT (branch_id,index_name) DO UPDATE SET
+                    world_revision_id=EXCLUDED.world_revision_id, branch_seq=EXCLUDED.branch_seq,
+                    generation=w.generation+1
+            """), {**wr, "seq": branch_seq, "names": advance})
+        return bool(advance)
