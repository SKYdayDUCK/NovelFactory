+    def task_with_locked_authority(self, task_id, grant_id):
+        tasks, inputs, works, grants = (self.tables[name] for name in ("tasks", "task_inputs", "works", "grants"))
+        query = _task_with_authority_query(tasks, inputs, works, grants)
+        row = self.conn.execute(query, {"requested_task": task_id, "requested_grant": grant_id}).mappings().one_or_none()
+        if row is None:
+            return None, None, None, None
+        task = {column.key: row[column] for column in tasks.c}
+        work = {"work_id": row["locked_work_id"]} if row["locked_work_id"] is not None else None
+        grant = ({column.key: row["locked_grant_" + column.key] for column in grants.c}
+                 if row["locked_grant_grant_id"] is not None else None)
+        return task, work, grant, row["world_ref"]
+
     def revision_with_snapshot_text(self, world_ref):
