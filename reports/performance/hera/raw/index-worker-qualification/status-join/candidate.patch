@@ -34,6 +34,24 @@ def _task_with_locked_work_query(tasks, inputs, works):
             .where(tasks.c.task_id == bindparam("requested_task")))
 
 
+@lru_cache(maxsize=4)
+def _task_with_authority_query(tasks, inputs, works, grants):
+    generation = and_(inputs.c.task_id == tasks.c.task_id, inputs.c.generation == tasks.c.generation)
+    locked_work = (select(works.c.work_id).where(works.c.work_id == tasks.c.work_id).correlate(tasks)
+                   .with_for_update(read=True, of=works).lateral("locked_work"))
+    # This LATERAL requires the owning work returned by the first locking
+    # subquery. Administrators lock work before grant in the same order.
+    locked_grant = (select(grants).where(grants.c.grant_id == bindparam("requested_grant"),
+                                         grants.c.work_id == locked_work.c.work_id)
+                    .correlate(locked_work).with_for_update(read=True, of=grants).lateral("locked_grant"))
+    grant_columns = [column.label("locked_grant_" + column.key) for column in locked_grant.c]
+    return (select(tasks, inputs.c.spec["world_ref"].label("world_ref"),
+                   locked_work.c.work_id.label("locked_work_id"), *grant_columns)
+            .select_from(tasks.outerjoin(inputs, generation).outerjoin(locked_work, true())
+                         .outerjoin(locked_grant, true()))
+            .where(tasks.c.task_id == bindparam("requested_task")))
+
+
 class KernelRepository:
     def __init__(self, conn, tables):
         self.conn, self.tables = conn, tables
