         require(work and grant and grant["active"] and grant["principal_id"] == principal.principal_id
                 and grant["work_id"] == work_id, "VIEW_DENIED", "Resource unavailable for this identity")
         self._check_resume_grant(r, grant)
@@ -509,14 +513,38 @@ class Kernel:
         task=r.one("tasks",{"task_id":task_id})
         require(task,"VIEW_DENIED","Task unavailable")
         g=self.authorize(r,principal,task["work_id"],capability,task["branch_id"])
-        require(task["principal_id"]==principal.principal_id and task["grant_id"]==principal.grant_id,"VIEW_DENIED","Task unavailable")
+        self._require_task_owner(task, principal)
         return task,g
 
+    @staticmethod
+    def _require_task_owner(task, principal):
+        require(task["principal_id"] == principal.principal_id and task["grant_id"] == principal.grant_id,
+                "VIEW_DENIED", "Task unavailable")
+
+    @staticmethod
+    def _public_task(task, world_ref):
+        return {**{k: v for k, v in task.items() if k not in {"principal_id", "grant_id", "lease_owner"}},
+                "world_ref": world_ref}
+
     def get_task(self,principal,task_id):
         with self.db.uow(write=False) as r:
             task,_=self._task_owner(r,principal,task_id)
-            task["world_ref"]=r.one("task_inputs",{"task_id":task_id,"generation":task["generation"]})["spec"]["world_ref"]
-        return {k:v for k,v in task.items() if k not in {"principal_id","grant_id","lease_owner"}}
+            world_ref = r.one("task_inputs", {"task_id": task_id, "generation": task["generation"]})["spec"]["world_ref"]
+        return self._public_task(task, world_ref)
+
+    def get_task_with_locked_work(self, principal, task_id):
+        """Read the exact generation and SHARE-lock its owning work before the grant."""
+        if not isinstance(principal, Principal):
+            # Preserve the regular path's error precedence and locking behavior.
+            return Kernel.get_task(self, principal, task_id)
+        with self.db.uow(write=False) as repo:
+            task, work, world_ref = repo.task_with_locked_work(task_id)
+            require(task is not None, "VIEW_DENIED", "Task unavailable")
+            grant = repo.one("grants", {"grant_id": principal.grant_id}, lock="share")
+            self._validate_locked_grant(repo, principal, task["work_id"], "READ", task["branch_id"], work, grant)
+            self._require_task_owner(task, principal)
+            require(world_ref is not None, "INTERNAL_ERROR", "Task input unavailable")
+            return self._public_task(task, world_ref)
 
     def cancel_task(self,principal,task_id,generation,idempotency_key):
         def authorize_cancel(conn):
diff --git a/src/novel_factory/infrastructure/repository.py b/src/novel_factory/infrastructure/repository.py
index d5a1c4869b2a95aac44c576f6c09a2db9a51728b..749fa6106ea5a19b1252a4abe4e1067b0e3d088e 100644
--- a/src/novel_factory/infrastructure/repository.py
+++ b/src/novel_factory/infrastructure/repository.py
@@ -3,7 +3,7 @@ from __future__ import annotations
 
 from functools import lru_cache
 
-from sqlalchemy import Text, bindparam, select, update, delete, and_, func, text
+from sqlalchemy import Text, bindparam, select, update, delete, and_, func, text, true
 from sqlalchemy.dialects.postgresql import insert
 
 @lru_cache(maxsize=4)
@@ -21,6 +21,19 @@ def _revision_text_query(revision):
     )
 
 
+@lru_cache(maxsize=4)
+def _task_with_locked_work_query(tasks, inputs, works):
+    generation = and_(inputs.c.task_id == tasks.c.task_id, inputs.c.generation == tasks.c.generation)
+    locked_work = (select(works).where(works.c.work_id == tasks.c.work_id).correlate(tasks)
+                   .with_for_update(read=True, of=works).lateral("locked_work"))
+    # Keep the owning work's complete typed row separate from the public task.
+    # A policy update or a grant revocation still must synchronize on live rows.
+    work_columns = [column.label("locked_work_" + column.key) for column in locked_work.c]
+    return (select(tasks, inputs.c.spec["world_ref"].label("world_ref"), *work_columns)
+            .select_from(tasks.outerjoin(inputs, generation).outerjoin(locked_work, true()))
+            .where(tasks.c.task_id == bindparam("requested_task")))
+
+
 class KernelRepository:
     def __init__(self, conn, tables):
         self.conn, self.tables = conn, tables
@@ -29,6 +42,17 @@ class KernelRepository:
         rows = self.many(name, where, lock=lock, limit=1)
         return rows[0] if rows else None
 
+    def task_with_locked_work(self, task_id):
+        tasks, inputs, works = (self.tables[name] for name in ("tasks", "task_inputs", "works"))
+        query = _task_with_locked_work_query(tasks, inputs, works)
+        row = self.conn.execute(query, {"requested_task": task_id}).mappings().one_or_none()
+        if row is None:
+            return None, None, None
+        task = {column.key: row[column] for column in tasks.c}
+        work = ({column.key: row["locked_work_" + column.key] for column in works.c}
+                if row["locked_work_work_id"] is not None else None)
+        return task, work, row["world_ref"]
+
     def revision_with_snapshot_text(self, world_ref):
         query = _revision_text_query(self.tables["revisions"])
         row = self.conn.execute(query, world_ref).mappings().one_or_none()
