from pathlib import Path
import subprocess, json, sys, os
root=Path(sys.argv[1]).resolve()
ruff=os.environ.get("RUFF", "ruff")
def write(p,s):
    p.parent.mkdir(parents=True,exist_ok=True)
    p.write_text(s)
def fmt(p):
    subprocess.run([ruff,"format","--line-length","110",str(p)],check=True,cwd=root)
sources={"tests/integration/test_harness_log_upgrade.py":"\"\"\"Prove populated observation upgrades preserve earlier evidence rows.\"\"\"\nimport os\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nimport pytest\nfrom sqlalchemy import text\n\nfrom novel_factory.application.audit_log import record\nfrom novel_factory.fixtures import create_bound_task, load_fixture, point\n\npytestmark = [pytest.mark.postgres, pytest.mark.integration]\n\n\ndef test_populated_0019_history_and_guarded_downgrade(kernel_env):\n    kernel=kernel_env[\"kernel\"]\n    cmd=[sys.executable,\"-m\",\"alembic\"]\n    cli={\"env\":{**os.environ,\"NF_DATABASE_URL\":kernel_env[\"url\"]},\n         \"cwd\":Path(__file__).resolve().parents[2],\"capture_output\":True,\"text\":True}\n    subprocess.run([*cmd,\"downgrade\",\"0019_p57_context_sources\"],**cli,check=True)\n    world=load_fixture(kernel)\n    base=world[\"world_ref\"]\n    with kernel.db.uow() as repo:\n        event=record(repo.conn,\"operator.preexisting\",**base)\n        original=repo.conn.scalar(text(\"SELECT to_jsonb(a) FROM nf_audit_events a WHERE event_id=:event\"),{\"event\":event})\n    subprocess.run([*cmd,\"upgrade\",\"head\"],**cli,check=True)\n    with kernel.db.uow() as repo:\n        row=repo.conn.scalar(text(\"SELECT to_jsonb(a) FROM nf_audit_events a WHERE event_id=:event\"),{\"event\":event})\n        assert row.pop(\"harness_details\") is None and row==original\n    job=create_bound_task(kernel,world[\"principal\"],base,point(1))\n    with kernel.db.uow() as repo:\n        observed=repo.conn.scalar(text(\"SELECT to_jsonb(a) FROM nf_audit_events a WHERE task_id=:t AND event_type='context.compiled'\"),{\"t\":job[\"task_id\"]})\n    assert observed[\"harness_details\"][\"packet_bytes\"]>0\n    failed=subprocess.run([*cmd,\"downgrade\",\"0019_p57_context_sources\"],**cli)\n    assert failed.returncode and 'preserve recorded Harness observations' in failed.stderr\n    with kernel.db.uow() as repo:\n        assert observed==repo.conn.scalar(text(\"SELECT to_jsonb(a) FROM nf_audit_events a WHERE event_id=:id\"),{\"id\":observed[\"event_id\"]})\n","workshop/integration/test_workshop_harness_log_upgrade.py":"\"\"\"Upgrade a populated W010 source cut with every original event unchanged.\"\"\"\nfrom uuid import uuid4\n\nimport pytest\nfrom alembic import command\nfrom psycopg import sql\nfrom sqlalchemy.engine import make_url\n\nfrom agent_workshop.auth import connect\nfrom agent_workshop.migrate import config\nfrom agent_workshop.organization import bootstrap\n\n\ndef test_populated_w010_preserves_historical_cut_and_guarded_downgrade(dual_databases,monkeypatch):\n    base=dual_databases[\"aw\"]\n    schema=\"p57_aw_history_\"+uuid4().hex\n    with connect(base) as conn:\n        conn.execute(sql.SQL(\"CREATE SCHEMA {}\").format(sql.Identifier(schema)))\n    dsn=make_url(base).update_query_dict({\"options\":\"-csearch_path=\"+schema}).render_as_string(hide_password=False)\n    monkeypatch.setenv(\"AW_DATABASE_URL\",dsn)\n    org, installation=\"stage-six\",str(uuid4())\n    try:\n        command.upgrade(config(),\"w010\")\n        with connect(dsn) as conn:\n            conn.execute(\"INSERT INTO aw_installations (installation_id,nf_instance_id,enabled) VALUES (%s,%s,true)\",(installation,str(uuid4())))\n            bootstrap(conn,org,installation_id=installation)\n        def snapshot():\n            with connect(dsn) as conn:\n                return conn.execute(\"SELECT * FROM aw_change_log WHERE org_id=%s ORDER BY seq\",(org,)).fetchall()\n        before=snapshot()\n        assert before and any(r[\"source\"]==\"aw_employment_versions\" for r in before)\n        command.upgrade(config(),\"head\")\n        assert before==snapshot()\n        with connect(dsn) as conn:\n            assert conn.execute(\"SELECT version_num FROM aw_alembic_version\").fetchone()[\"version_num\"]==\"w011\"\n            assert conn.execute(\"SELECT cut FROM aw_source_cuts WHERE org_id=%s\",(org,)).fetchone()[\"cut\"]==before[-1][\"seq\"]\n        with pytest.raises(RuntimeError,match=\"paired backup\"):\n            command.downgrade(config(),\"w010\")\n        assert before==snapshot()\n    finally:\n        with connect(base) as conn:\n            conn.execute(sql.SQL(\"DROP SCHEMA {} CASCADE\").format(sql.Identifier(schema)))\n","workshop/integration/test_workshop_harness_observations.py":"\"\"\"Correlate independently authenticated Workshop history and NF audit evidence.\"\"\"\nimport json\n\nimport pytest\n\nfrom novel_factory.application.audit_log import LogService\nfrom novel_factory.application.workshop_skills import DynamicSkillAuthority\nfrom novel_factory.domain.errors import DomainError\nfrom test_dynamic_skill_dispatch import call, dynamic_site  # noqa: F401\n\n\ndef test_correlated_delegation_freeze_withdrawal_and_denial(dynamic_site):\n    site = dynamic_site\n    source = site.delegate(\"audit-origin\")\n    method = \"BLUE-WREN-SKILL-CANARY must never be serialized to an audit row.\"\n    identity = \"SENSITIVE-PROFILE-LABEL-CANARY\"\n    binding = site.share(\"v1\", method)\n    reg = site.activate(source, binding, method, profile=identity)\n    job = site.delegate(\"audit-target\", reg[\"instance_ref\"])\n    authority = DynamicSkillAuthority(site.kernel)\n    authority.refresh(job.principal, job.task_id, job.generation, workshop_binding=binding)\n    call(site.ports[\"manager\"], \"aw_skill_revoke\", operation_id=\"audit-revoke\", binding_id=binding[\"binding_id\"])\n    with pytest.raises(DomainError):\n        authority.refresh(job.principal, job.task_id, job.generation, workshop_binding=binding)\n\n    events = LogService.trace(site.kernel, site.owner, site.wr[\"work_id\"],site.wr[\"branch_id\"],job.task_id)\n    with pytest.raises(DomainError):\n        LogService.trace(site.kernel,job.principal,site.wr[\"work_id\"],site.wr[\"branch_id\"],job.task_id)\n    assert not LogService.trace(site.kernel,site.owner,site.wr[\"work_id\"],site.kernel.fork(\n        site.owner, site.wr, \"CANDIDATE\", \"other-audit-branch\")[\"branch_id\"],job.task_id)\n    names = {row[\"event_type\"]: row for row in events}\n    bound = names[\"harness.delegation.bound\"][\"harness_details\"]\n    verified = names[\"harness.skill.verified\"][\"harness_details\"]\n    denied = names[\"harness.skill.denied\"]\n    assert denied[\"error_code\"] == \"DYNAMIC_SKILL_DENIED\" and denied[\"outcome\"] == \"DENIED\"\n    assert all(verified[k] == denied[\"harness_details\"][k] == bound[k]\n               for k in (\"operation_id\", \"installation_id\", \"receipt_ref\"))\n    aw = []\n    cursor = None\n    while True:\n        response = call(site.ports[\"manager\"], \"aw_history_get\", limit=100, **({\"cursor\":cursor} if cursor else {}))\n        aw.extend(response[\"events\"])\n        cursor = response[\"next_cursor\"]\n        if not cursor:\n            break\n    remote = [r[\"data\"] for r in aw if r[\"source\"] == \"aw_remote_receipts\" and r[\"ref_id\"] == bound[\"operation_id\"]]\n    freeze = [r[\"data\"] for r in aw if r[\"source\"] == \"harness.skill.frozen\" and r[\"data\"][\"task_id\"] == job.task_id]\n    withdrawal = [r[\"data\"] for r in aw if r[\"source\"] == \"harness.skill.withdrawn\" and r[\"ref_id\"] == binding[\"binding_id\"]]\n    assert remote and remote[0][\"receipt_ref\"] == bound[\"receipt_ref\"] and remote[0][\"world_ref\"] == site.wr\n    assert len(freeze) == 1 and freeze[0][\"receipt_ref\"] == bound[\"receipt_ref\"]\n    assert len(withdrawal) == 1 and withdrawal[0][\"binding_id\"] == denied[\"harness_details\"][\"binding_id\"]\n    assert withdrawal[0][\"skill_epoch\"] > freeze[0][\"skill_epoch\"]\n    public = json.dumps([events, aw], default=str)\n    assert method not in public and identity not in public and job.frozen.private_token not in public\n","tests/integration/test_harness_observations.py":"\"\"\"Server-timed, tenant-scoped observations from actual compiled bundles and model calls.\"\"\"\nimport json\n\nimport pytest\n\nfrom novel_factory.application.audit_log import LogService\nfrom novel_factory.domain.canonical import canonical_bytes\nfrom novel_factory.domain.errors import DomainError\nfrom novel_factory.infrastructure.creative_config import CreativeHarnessConfig\nfrom test_agent_gateway import setup_gateway\n\n\npytestmark = [pytest.mark.postgres, pytest.mark.integration]\n\n\ndef test_native_compile_packet_and_attempt_have_scoped_content_free_trace(kernel_env,monkeypatch):\n    monkeypatch.setenv(\"NF_CREATIVE_HARNESS_CONFIG\",json.dumps(CreativeHarnessConfig(enabled=True).as_dict()))\n    site=setup_gateway(kernel_env)\n    kernel=site[\"kernel\"]\n    result=site[\"gateway\"].execute(site[\"principal\"],site[\"request\"])\n    task=site[\"task\"]\n    world=site[\"world\"]\n    wr=world[\"world_ref\"]\n    def rows():\n        return LogService.trace(kernel,world[\"principal\"],wr[\"work_id\"],wr[\"branch_id\"],task[\"task_id\"])\n    first=rows()\n    by_name={row[\"event_type\"]:row for row in first}\n    native=by_name[\"context.compiled\"]\n    packet=by_name[\"harness.context.packet\"]\n    model=by_name[\"model.completed\"]\n    with kernel.db.uow(write=False) as repo:\n        scoped=repo.one(\"artifacts\",{\"artifact_revision_id\":packet[\"evidence_id\"]})[\"payload\"]\n        compiled=repo.one(\"contexts\",{\"context_bundle_id\":native[\"evidence_id\"]})[\"compiled\"]\n    assert native[\"duration_ms\"] > 0 and packet[\"duration_ms\"] > 0\n    assert native[\"harness_details\"][\"packet_bytes\"]==len(canonical_bytes(compiled))\n    details=packet[\"harness_details\"]\n    assert details[\"packet_bytes\"]==len(canonical_bytes(scoped[\"model_input\"]))\n    assert details[\"source_count\"]==len(scoped[\"packet\"][\"sources\"])\n    assert details[\"omitted_count\"]==len(scoped[\"packet\"][\"omissions\"])\n    assert details[\"switches\"]=={\"enabled\":True,\"dynamic_agents\":False,\"adaptive_instructions\":False,\"auto_promote\":False}\n    assert details[\"role_version\"] and details[\"skill_version\"] and details[\"runtime_sha256\"]\n    assert model[\"attempt_id\"]==result[\"attempt_id\"] and model[\"harness_details\"][\"input_tokens\"] is not None\n    assert model[\"harness_details\"][\"cost_status\"] == \"KNOWN\"\n    assert all(str(r[\"world_revision_id\"])==wr[\"world_revision_id\"] and r[\"generation\"]==task[\"generation\"]\n               for r in (native,packet,model))\n    assert site[\"gateway\"].execute(site[\"principal\"],site[\"request\"])[\"attempt_id\"]==result[\"attempt_id\"]\n    assert [r[\"event_id\"] for r in rows()]==[r[\"event_id\"] for r in first]\n    protected=json.dumps(first,ensure_ascii=False,default=str)\n    assert scoped[\"model_input\"][\"assignment\"] not in protected\n    for key in (\"model_input\", \"role_contract\", \"skill_instructions\", \"statement\", \"messages\"):\n        assert '\"'+key+'\"' not in protected\n    with pytest.raises(DomainError):\n        LogService.trace(kernel,site[\"principal\"],wr[\"work_id\"],wr[\"branch_id\"],task[\"task_id\"])\n"}
for name,source in sources.items():
    p=root/name
    write(p,source)
    fmt(p)
p=root/"tests/integration/test_harness_observations.py"
s=p.read_text().replace('from test_agent_gateway import setup_gateway','from test_agent_gateway import setup_gateway\nfrom test_harness_context import EnvelopeFixture').replace('site = setup_gateway(kernel_env)','site = setup_gateway(kernel_env, EnvelopeFixture())').replace('compiled = repo.one("contexts", {"context_bundle_id": native["evidence_id"]})["compiled"]','compiled_ref = repo.one("contexts", {"context_bundle_id": native["evidence_id"]})["artifact_ref"]\n        compiled = kernel.artifact(repo, compiled_ref, wr["work_id"])["payload"]')
s=s.replace('model["attempt_id"] == result["attempt_id"]','str(model["attempt_id"]) == result["attempt_id"]')
s=s.replace('import json','import json\nfrom datetime import timedelta').replace('from test_agent_gateway import setup_gateway','from novel_factory.infrastructure.model_gateway import ModelCallFailure\nfrom test_agent_gateway import FixtureAdapter, setup_gateway')
s=s.replace('    assert model["harness_details"]["cost_status"] == "KNOWN"','''    assert model["harness_details"]["cost_status"] == "KNOWN"
    with kernel.db.uow(write=False) as repo:
        evidence = kernel.artifact(repo, result["evidence_ref"], wr["work_id"])["payload"]
    assert model["harness_details"]["prompt_ref"] == evidence["prompt_ref"]["artifact_revision_id"]
    assert model["harness_details"]["prompt_sha256"] == evidence["prompt_ref"]["sha256"]''')
s+='''
def test_unknown_attempt_and_expired_lease_keep_correlated_sanitized_error(kernel_env):
    def uncertain(_):
        raise ModelCallFailure("private-provider-diagnostic-CANARY")

    site = setup_gateway(kernel_env,FixtureAdapter(uncertain))
    kernel, world, task = site["kernel"], site["world"], site["task"]
    result = site["gateway"].execute(site["principal"],site["request"])
    assert result["status"] == "BLOCKED" and result["cost_status"] == "UNKNOWN_COST"
    with kernel.db.uow() as repo:
        repo.change("tasks",{"task_id":task["task_id"]},{"lease_expiry":repo.now()-timedelta(seconds=1)})
    kernel.tasks.recover_expired()
    wr = world["world_ref"]
    rows = LogService.trace(kernel,world["principal"],wr["work_id"],wr["branch_id"],task["task_id"])
    error = next(r for r in rows if r["event_type"]=="model.completed")
    assert error["error_code"]=="OTHER_MODEL_ERROR"
    assert error["harness_details"]["actual_amount"] is None and error["harness_details"]["input_tokens"] is None
    fenced = next(r for r in rows if r["event_type"] == "harness.task.recovered")
    assert fenced["outcome"]=="PAUSED" and fenced["generation"]==error["generation"]+1
    assert fenced["harness_details"]["transition"]=="LEASE_RECOVERY" and fenced["harness_details"]["unresolved_attempts"]==1
    assert "private-provider-diagnostic-CANARY" not in json.dumps(rows,default=str)


def test_simulation_logs_branch_limits_and_planning_choice_without_actor_facts(scene):
    from test_harness_planning_simulation import propose, simulate, decide
    candidate=propose(scene)
    run=simulate(scene,candidate,branches=1,steps=1)
    decide(scene,candidate,None,"observe-decline")
    wr=scene["wr"]
    trace=LogService.trace(scene["kernel"],scene["owner"],wr["work_id"],wr["branch_id"],scene["planner"].task["task_id"])
    named={row["event_type"]:row for row in trace}
    metrics=named["harness.simulation.completed"]["harness_details"]
    assert named["harness.plan.candidate"]["harness_details"]["candidate_count"]==len(candidate["candidate"]["alternatives"])
    assert metrics["step_count"]==sum(s["steps"] for s in run["stops"]) and metrics["stop_reasons"]["BRANCH_LIMIT"]>=1
    assert metrics["model_attempts"]==0
    assert named["harness.plan.decision"]["outcome"]=="DECLINED"
    evidence=json.dumps(trace,default=str)
    for field in ("path", "expected_value", "assumptions", "beliefs"):
        assert '"'+field+'"' not in evidence
'''
s=s.replace('from test_harness_context import EnvelopeFixture','from test_harness_context import EnvelopeFixture\nfrom test_harness_planning_simulation import scene  # noqa: F401')
write(p,s)
fmt(p)

