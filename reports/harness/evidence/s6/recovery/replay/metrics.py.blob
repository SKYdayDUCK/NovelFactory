t.write_text(s+"\n\ndef test_rework_is_not_fixed_until_independent_reread_and_native_editor_acceptance(kernel_env,tmp_path,monkeypatch):\n    from test_harness_review_workflow import CHANGE, LINE, _args, _formal, _repeat, _reviewer, _writer\n    from test_release import accept_draft,setup_batch,write_scene\n    from novel_factory.application.creative_review import CreativeReviewService\n\n    k=kernel_env[\"kernel\"]\n    f=setup_batch(k,count=1)\n    owner,wr=f[\"principal\"],f[\"world_ref\"]\n    svc=CreativeReviewService(k)\n    metrics=CreativeMetricsService(k)\n    draft=accept_draft(k,f,write_scene(k,f,0,LINE*3))\n    reviewer,args,read = _reviewer(k,f,draft,tmp_path,monkeypatch)\n    report=svc.review(*_args(reviewer),**{**args,\"observations\":[_repeat(read)]})\n    svc.decide(owner,*_args(reviewer)[1:],report_ref=report[\"report_ref\"],action=\"RETURN\",reason=\"定向改动并复审。\",idempotency_key=\"return\")\n    writer=_writer(k,f,draft,report[\"report_ref\"])\n    child=svc.revise(*_args(writer),report_ref=report[\"report_ref\"],scene_ref=f[\"scene_refs\"][0],worker_id=writer.worker_id,\n                     replacements=[{\"finding_id\":report[\"findings\"][0][\"finding_id\"],\"replacement\":CHANGE}],idempotency_key=\"replace\")\n    before=metrics.report(owner,wr)[\"review\"]\n    assert before[\"targeted_revisions\"]==1 and before[\"independently_fixed\"]=={\"numerator\":0,\"denominator\":1,\"rate\":0}\n    edited=accept_draft(k,f,{\"writer\":writer.principal,\"task\":writer.task,\"draft_ref\":child[\"draft_ref\"],\"text\":LINE*2+CHANGE})\n    newjob,newargs,newread=_reviewer(k,f,edited,tmp_path,monkeypatch)\n    reread=svc.review(*_args(newjob),**{**newargs,\"quota\":args[\"quota\"],\"prior_report_ref\":report[\"report_ref\"]})\n    svc.decide(owner,*_args(newjob)[1:],report_ref=reread[\"report_ref\"],action=\"ACCEPT_REVISION\",reason=\"已核对正文及上次指出的问题。\",\n               idempotency_key=\"approve\",native_decision=_formal(k,f,svc,newjob,newargs,newread,reread))\n    after=metrics.report(owner,wr)[\"review\"]\n    assert after[\"targeted_revisions\"]==1 and after[\"independently_fixed\"]=={\"numerator\":1,\"denominator\":1,\"rate\":1}\n    assert after[\"coverage\"]=={\"numerator\":2,\"denominator\":2,\"rate\":1}\n")
subprocess.run(['ruff','check','--fix',str(t),str(m)],check=True)
