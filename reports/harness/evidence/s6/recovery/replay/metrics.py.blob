s=t.read_text().replace('from test_harness_dynamic_registry import delegated_site, setup\nfrom test_harness_planning_simulation import decide, propose, scene, simulate','import test_harness_dynamic_registry\nimport test_harness_planning_simulation\nfrom test_harness_planning_simulation import decide, propose, simulate')
