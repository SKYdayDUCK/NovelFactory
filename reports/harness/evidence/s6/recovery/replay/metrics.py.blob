t.write_text(t.read_text()+"\n\ndef test_measured_packets_scene_billing_and_provider_tokens_survive_unknown_amount(kernel_env, monkeypatch):\n    from decimal import Decimal\n    from test_release import setup_batch\n    from test_harness_context import EnvelopeFixture, configured\n    from novel_factory.application.agent_gateway import AgentGateway\n    from novel_factory.application.planning import PlanningService\n    from novel_factory.application.release import ReleaseService\n    from novel_factory.application.runtime_tasks import RuntimeTaskService\n    from novel_factory.domain.canonical import canonical_bytes\n    from novel_factory.fixtures import point\n\n    k = kernel_env[\"kernel\"]\n    f = setup_batch(k, count=2)\n    wr, owner = f[\"world_ref\"], f[\"principal\"]\n    flags = configured(monkeypatch)\n    budget = k.tasks.create_budget(wr[\"work_id\"], \"1\")\n    expected_bytes = []\n    expected_sources = []\n    for i, amount in enumerate((Decimal(\"0.01\"),None)):\n        adapter=EnvelopeFixture(amount=amount)\n        gw=AgentGateway(k,{\"fixture\":adapter},creative_harness=flags)\n        job=RuntimeTaskService(k,gw).prepare(owner,wr,role_id=\"writer\",task_kind=\"scene_draft\",story_time=point(1,1),\n            subject_ids=[f[\"ids\"][\"sword\"]],predicates=[\"possessed_by\"],assignment=\"记录河岸一幕。\",adapter_id=\"fixture\",\n            input_artifacts=[f[\"plan_ref\"],f[\"batch_ref\"],f[\"scene_refs\"][i]])\n        tid,gen=job.task[\"task_id\"],job.task[\"generation\"]\n        PlanningService(k).bind_task_for_controller(owner,tid,gen,f[\"plan_ref\"],f[\"scenes\"][i][\"plan_node_ids\"],\"bind-plan-\"+tid)\n        ReleaseService(k).bind_writer_task(job.principal,tid,gen,f[\"scene_refs\"][i],[],\"bind-scene-\"+tid)\n        req={\"schema_version\":\"2.1\",\"task_id\":tid,\"generation\":gen,\"worker_id\":job.worker_id,\"call_key\":\"measure\",\n             \"input_ref\":job.agent_input[\"input_ref\"],\"budget_id\":budget,\"reserve_amount\":\"0.1\",\"token_reservation\":100000}\n        first=gw.execute(job.principal,req)\n        assert gw.execute(job.principal,req)==first and len(adapter.calls)==1\n        expected_bytes.append(len(canonical_bytes(json.loads(adapter.calls[0].messages[1][\"content\"]))))\n        with k.db.uow(write=False) as repo:\n            audit=k.artifact(repo,first[\"evidence_ref\"],wr[\"work_id\"])[\"payload\"]\n            packet=k.artifact(repo,audit[\"creative_context_ref\"],wr[\"work_id\"])[\"payload\"][\"packet\"]\n            expected_sources.append(len(packet[\"sources\"]))\n    m=CreativeMetricsService(k)\n    result=m.report(owner,wr)\n    assert result[\"context\"][\"packet_build_ms\"][\"n\"] == 2 and result[\"context\"][\"compile_ms\"][\"n\"] >= 2\n    assert result[\"context\"][\"model_input_bytes\"][\"sum\"] == sum(expected_bytes)\n    assert result[\"context\"][\"loaded_sources\"][\"sum\"] == sum(expected_sources)\n    assert result[\"context\"][\"compiled_bytes\"][\"sum\"] > 0\n    assert result[\"dynamic\"][\"dispatched_skill_versions\"][0][\"calls\"] == 2\n    assert result[\"latency\"][\"model_call_ms_by_execution_kind\"][\"TEST_FIXTURE\"][\"n\"]==2\n    scenes = {row[\"scene_id\"]: row for row in result[\"scenes\"]}\n    known, unknown = [scenes[s[\"scene_contract\"][\"scene_id\"]] for s in f[\"scenes\"]]\n    assert known[\"actual_tokens\"]==unknown[\"actual_tokens\"]==65\n    assert known[\"actual_amount\"]==\"0.010000\" and unknown[\"actual_amount\"] is None\n    assert unknown[\"tokens_from_unsettled_provider_receipts\"]==unknown[\"unknown_amount_attempts\"]==1\n    assert known[\"execution_origin\"]==unknown[\"execution_origin\"]==\"TEST_FIXTURE\"\n    assert result[\"review\"][\"heldout_review_errors\"][\"CONTROL\"][\"false_negatives\"] is None\n\n\ndef test_real_lease_fence_and_reclaimed_generation_counts_once(kernel_env,monkeypatch):\n    from test_harness_context import EnvelopeFixture, configured\n    from novel_factory.application.agent_gateway import AgentGateway\n    from novel_factory.application.runtime_tasks import RuntimeTaskService\n    from novel_factory.application.queries import WorldQueryService\n    from novel_factory.fixtures import point\n\n    k=kernel_env[\"kernel\"]\n    w=load_fixture(k)\n    wr,owner=w[\"world_ref\"],w[\"principal\"]\n    gw=AgentGateway(k,{\"fixture\": EnvelopeFixture()},creative_harness=configured(monkeypatch))\n    job=RuntimeTaskService(k,gw).prepare(owner,wr,role_id=\"writer\",task_kind=\"scene_draft\",story_time=point(1,1),\n          subject_ids=[w[\"ids\"][\"sword\"]],predicates=[\"possessed_by\"],assignment=\"清点原有的事实。\",adapter_id=\"fixture\")\n    tid=job.task[\"task_id\"]\n    with k.db.uow() as repo:\n        repo.change(\"tasks\",{\"task_id\":tid},{\"lease_expiry\":repo.now()-timedelta(seconds=2)})\n    (blocked,)=k.tasks.recover_expired()\n    assert blocked[\"state\"]==\"READY\"\n    service=CreativeMetricsService(k)\n    assert service.report(owner,wr)[\"recovery\"][\"success_after_failure\"]=={\"numerator\":0,\"denominator\":1,\"rate\":0}\n    claimed=k.claim_task(job.principal,\"replacement\",task_id=tid,lease_seconds=60)\n    gen=claimed[\"generation\"]\n    WorldQueryService(k).context_compile(job.principal,{\"schema_version\":\"2.1\",\"task_id\":tid,\"generation\":gen,\n        \"recipe_id\":\"WRITER\",\"input_manifest_ref\":job.manifest_ref,\n        \"read_contract\":{\"revision\":{\"mode\":\"FIXED\",\"world_ref\":wr},\"process_policy\":\"ALLOW_PARTIAL\",\"index_policy\":\"AUTHORITATIVE\",\"max_wait_ms\":0},\n        \"knowledge_cut\":{\"plane\":\"WORLD\"},\"subject_time\":{\"kind\":\"POINT\",\"at\":point(1,1)},\"token_budget\":20000,\"idempotency_key\":\"metric-recover\"})\n    budget=k.tasks.create_budget(wr[\"work_id\"],\"1\")\n    gw.execute(job.principal,{\"schema_version\":\"2.1\",\"task_id\":tid,\"generation\":gen,\"worker_id\":\"replacement\",\"call_key\":\"finish\",\n                            \"input_ref\":job.agent_input[\"input_ref\"],\"budget_id\":budget,\"reserve_amount\":\"0.1\",\"token_reservation\":100000})\n    assert service.report(owner,wr)[\"recovery\"][\"success_after_failure\"]=={\"numerator\":1,\"denominator\":1,\"rate\":1}\n")
