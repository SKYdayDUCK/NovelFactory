#!/usr/bin/env python3
"""Replay the original S6 metrics edits in an otherwise empty target checkout.

Run from the matching NovelFactory revision with its pyproject.toml and original Ruff.
The original staged files contained 500 and 381 lines; their complete original
blob hashes were not available in the lost runtime. Compare the assembled tree
to 9a7b09f11e98a1eec87316869eca54240db2c15f for exact object verification.
This script never changes a Git ref or the Git index.
"""
from pathlib import Path
import hashlib
import subprocess

m=Path('src/novel_factory/application/creative_metrics.py')
t=Path('tests/integration/test_creative_metrics.py')
if m.exists() or t.exists():
    raise SystemExit("Run on a disposable checkout missing both S6 metrics files")
m.parent.mkdir(parents=True,exist_ok=True)
t.parent.mkdir(parents=True,exist_ok=True)
def format_files(*paths):
    subprocess.run(['ruff','format',*map(str,paths)],check=True)

m.write_text("\"\"\"Read-only, branch-authorized engineering measurements on a bounded PostgreSQL snapshot.\"\"\"\n\nfrom collections import Counter, defaultdict\nfrom datetime import UTC, datetime, timedelta\nfrom decimal import Decimal\nfrom math import ceil\n\nfrom sqlalchemy import text\n\nfrom novel_factory.application.kernel import require\nfrom novel_factory.contracts.registry import validate_contract\nfrom novel_factory.domain.errors import DomainError\n\n\ndef _time(value):\n    if value is None:\n        return None\n    try:\n        stamp = datetime.fromisoformat(value)\n        if stamp.tzinfo is not None:\n            return stamp.astimezone(UTC)\n    except (TypeError, ValueError, OverflowError):\n        pass\n    raise DomainError(\"INVALID_ARGUMENT\", \"Use an ISO 8601 timestamp with an explicit timezone\")\n\n\ndef _ratio(numerator, denominator):\n    return {\"numerator\": numerator, \"denominator\": denominator,\n            \"rate\": numerator / denominator if denominator else None}\n\n\ndef _distribution(values):\n    series = sorted(float(x) for x in values if x is not None)\n    return {\"n\": len(series), \"sum\": sum(series) if series else None,\n            \"mean\": sum(series) / len(series) if series else None,\n            \"p95\": series[ceil(.95 * len(series)) - 1] if series else None}\n\n\ndef _rows(repo, query, params):\n    result = repo.conn.execute(text(query), params).mappings().all()\n    require(len(result) < params[\"fetch\"], \"CAPACITY_LIMIT\",\n            \"The complete metric population exceeds the row limit; narrow the time window\")\n    return result\n\n\n# Each projection runs only for the authorized window. Manuscript text, actor material,\n# issued instructions, evidence quotes and provider responses stay inside PostgreSQL.\n_BRANCH = \"\"\"coalesce(a.payload #>> '{scope,world_ref,branch_id}',\n a.payload #>> '{packet,scope,world_ref,branch_id}', a.payload #>> '{input_world_ref,branch_id}',\n a.payload #>> '{world_ref,branch_id}')\"\"\"\n_KINDS = (\n    \"CREATIVE_CONTEXT_SNAPSHOT\", \"CREATIVE_PLAN_CANDIDATE\", \"CREATIVE_SIMULATION_RUN\",\n    \"CREATIVE_PLAN_DECISION\", \"CREATIVE_REVIEW_DETAILS\", \"CREATIVE_REVIEW_DECISION\",\n    \"CREATIVE_REVIEW_REVISION\", \"NARRATIVE_DRAFT\", \"CREATIVE_DYNAMIC_INSTANCE\",\n    \"CREATIVE_DYNAMIC_EVENT\", \"CREATIVE_INSTRUCTION_CANDIDATE\", \"CREATIVE_INSTRUCTION_DECISION\",\n    \"CREATIVE_ADAPTIVE_ENGINEERING_REPORT\", \"CREATIVE_ADAPTIVE_MEASUREMENT\", \"AGENT_CALL_EVIDENCE\",\n)\n\n# Look up the immutable source generation/artifact by primary key even when created\n# before the observation window. This is lineage for an observed event, not an extra event.\n_ARTIFACTS = \"\"\"\nWITH population AS MATERIALIZED (\n SELECT a.* FROM nf_artifacts a WHERE a.work_id=:work AND a.kind=ANY(CAST(:kinds AS text[]))\n AND a.created_at >= :since AND a.created_at < :until AND \"\"\" + _BRANCH + \"\"\"=:branch\n ORDER BY a.created_at,a.artifact_revision_id LIMIT :fetch\n)\nSELECT a.kind, a.artifact_revision_id::text AS id, CASE a.kind\n WHEN 'CREATIVE_CONTEXT_SNAPSHOT' THEN jsonb_build_object(\n  'sources',jsonb_array_length(a.payload#>'{packet,sources}'),\n  'snapshot_bytes',(SELECT size FROM nf_objects o WHERE o.hash=a.sha256),\n  'ms',packet_event.duration_ms,'input_bytes',to_jsonb(packet_event)#>'{harness_details,packet_bytes}')\n WHEN 'CREATIVE_PLAN_CANDIDATE' THEN jsonb_build_object('alternatives',jsonb_array_length(a.payload->'alternatives'))\n WHEN 'CREATIVE_PLAN_DECISION' THEN jsonb_build_object('status',a.payload->'status')\n WHEN 'CREATIVE_SIMULATION_RUN' THEN jsonb_build_object(\n  'candidate',simulation.payload#>>'{plan_candidate_ref,artifact_revision_id}',\n  'options',ARRAY(SELECT s->>'option_id' FROM jsonb_array_elements(a.payload->'stops') s\n     WHERE CAST(s->>'steps' AS integer)>0))\n WHEN 'CREATIVE_REVIEW_DETAILS' THEN jsonb_build_object(\n  'report',a.payload#>>'{report_ref,artifact_revision_id}', 'layer',a.payload->'layer',\n  'drafts',ARRAY(SELECT d->>'artifact_revision_id' FROM jsonb_array_elements(a.payload->'scope_draft_refs') d),\n  'finding_count',jsonb_array_length(a.payload->'findings'),\n  'actionable',ARRAY(SELECT (a.payload->'findings'->CAST(f.i-1 AS integer))->>'finding_id'\n    FROM jsonb_array_elements(review.payload->'findings') WITH ORDINALITY AS f(v,i)\n    WHERE f.v->>'judgment' IN ('CONTRADICTION','PREFERENCE') AND coalesce(f.v->>'requested_change','')<>''),\n  'edited',ARRAY(SELECT f->>'finding_id' FROM jsonb_array_elements(a.payload->'prior_findings') f\n    WHERE f->>'judgment' IN ('CONTRADICTION','PREFERENCE') AND CAST(f->>'edited' AS boolean)),\n  'parent',a.payload#>>'{previous_report_ref,artifact_revision_id}')\n WHEN 'CREATIVE_REVIEW_DECISION' THEN jsonb_build_object('report',a.payload#>>'{report_ref,artifact_revision_id}','action',a.payload->'action')\n WHEN 'CREATIVE_DYNAMIC_EVENT' THEN jsonb_build_object('action',a.payload->'action')\n WHEN 'CREATIVE_INSTRUCTION_DECISION' THEN jsonb_build_object('decision',a.payload->'decision')\n WHEN 'CREATIVE_ADAPTIVE_ENGINEERING_REPORT' THEN jsonb_build_object('status',a.payload->'status','eligible',a.payload#>'{quality,eligible}')\n WHEN 'CREATIVE_ADAPTIVE_MEASUREMENT' THEN jsonb_build_object(\n   'eligible',a.payload->>'status'='SUCCEEDED' AND a.payload->'held_out'='true'::jsonb\n       AND a.payload->'independent_label'='true'::jsonb AND jsonb_typeof(a.payload#>'{output,payload,findings}')='array',\n   'arm',a.payload->'arm_id','tp',a.payload#>'{score,detected}','fp',a.payload#>'{score,false_positives}',\n   'fn',a.payload#>'{score,false_negatives}','gold',a.payload#>'{score,positives}')\n WHEN 'AGENT_CALL_EVIDENCE' THEN jsonb_build_object(\n   'ms',CAST(a.payload->>'elapsed_seconds' AS numeric)*1000,'attempt',a.payload->'attempt_id',\n   'execution_kind',a.payload->'execution_kind','skill',runtime.payload->'skill_name','version',runtime.payload->'skill_version',\n   'dynamic_content',dynamic.payload#>'{workshop_binding,content_sha}','dynamic_revision',dynamic.payload#>'{revision_ref,artifact_revision_id}')\n ELSE '{}'::jsonb END AS data\nFROM population a\nLEFT JOIN nf_audit_events packet_event ON a.kind='CREATIVE_CONTEXT_SNAPSHOT'\n AND packet_event.work_id=a.work_id AND packet_event.branch_id=CAST(:branch AS uuid)\n AND packet_event.event_type='harness.context.packet' AND packet_event.evidence_id=a.artifact_revision_id\nLEFT JOIN nf_artifacts simulation ON a.kind='CREATIVE_SIMULATION_RUN' AND simulation.work_id=a.work_id\n AND simulation.kind='CREATIVE_SIMULATION_REPORT' AND simulation.artifact_revision_id=CAST(a.payload#>>'{report_ref,artifact_revision_id}' AS uuid)\nLEFT JOIN nf_artifacts review ON a.kind='CREATIVE_REVIEW_DETAILS' AND review.work_id=a.work_id\n AND review.kind='CREATIVE_REVIEW_REPORT' AND review.artifact_revision_id=CAST(a.payload#>>'{report_ref,artifact_revision_id}' AS uuid)\nLEFT JOIN nf_artifacts input ON a.kind='AGENT_CALL_EVIDENCE' AND input.kind='AGENT_INPUT' AND input.work_id=a.work_id\n AND input.artifact_revision_id=CAST(a.payload#>>'{input_ref,artifact_revision_id}' AS uuid)\nLEFT JOIN nf_artifacts runtime ON runtime.kind='AGENT_RUNTIME' AND runtime.work_id=input.work_id\n AND runtime.artifact_revision_id=CAST(input.payload#>>'{runtime_ref,artifact_revision_id}' AS uuid)\nLEFT JOIN nf_artifacts dynamic ON a.kind='AGENT_CALL_EVIDENCE' AND dynamic.kind='CREATIVE_DYNAMIC_FREEZE' AND dynamic.work_id=a.work_id\n AND dynamic.artifact_revision_id=CAST(a.payload#>>'{dynamic_assignment_ref,artifact_revision_id}' AS uuid)\nORDER BY a.created_at,a.artifact_revision_id\n\"\"\"\n\n# A simulation is frozen once per candidate. Decisions observed by the end of the\n# window can therefore be compared with the exact options that actually ran.\n_DECISIONS = \"\"\"\nSELECT a.payload#>>'{candidate_ref,artifact_revision_id}' AS candidate,\n a.payload->>'option_id' AS option_id,a.payload->>'status' AS status\nFROM nf_artifacts a WHERE a.work_id=:work AND a.kind='CREATIVE_PLAN_DECISION'\n AND a.payload#>>'{scope,world_ref,branch_id}'=:branch AND a.created_at>=:since AND a.created_at<:until\n AND a.payload#>>'{candidate_ref,artifact_revision_id}'=ANY(CAST(:candidates AS text[])) LIMIT :fetch\n\"\"\"\n\n_CALLS = \"\"\"\nSELECT c.state,c.updated_at,c.actual_tokens,c.actual_amount,b.currency,\n scene.payload#>>'{scene_contract,scene_id}' AS scene\nFROM nf_call_attempts c JOIN nf_tasks t ON t.task_id=c.task_id\nJOIN nf_budgets b ON b.budget_id=c.budget_id AND b.work_id=t.work_id\nLEFT JOIN nf_selections w ON w.work_id=t.work_id AND w.selection_kind=concat('WRITING_TASK:',c.task_id,':',c.generation)\nLEFT JOIN nf_artifacts binding ON binding.work_id=t.work_id AND binding.kind='WRITING_TASK_BINDING'\n AND binding.artifact_revision_id=CAST(w.artifact_ref->>'artifact_revision_id' AS uuid)\n AND binding.payload#>>'{world_ref,branch_id}'=:branch AND binding.payload->>'task_id'=c.task_id::text\n AND CAST(binding.payload->>'generation' AS integer)=c.generation AND binding.created_at<:until\nLEFT JOIN nf_artifacts scene ON scene.work_id=t.work_id AND scene.kind='SCENE_PLAN'\n AND scene.artifact_revision_id=CAST(binding.payload#>>'{scene_ref,artifact_revision_id}' AS uuid)\nWHERE t.work_id=:work AND t.branch_id=CAST(:branch AS uuid) AND c.created_at>=:since AND c.created_at<:until\nORDER BY c.created_at,c.attempt_id LIMIT :fetch\n\"\"\"\n\n_TASK_EVENTS = \"\"\"\nSELECT o.aggregate_id AS task, CAST(o.payload->>'generation' AS integer) AS generation,\n o.payload->>'state' AS state,o.created_at,t.created_at AS started\nFROM nf_outbox o JOIN nf_tasks t ON t.task_id::text=o.aggregate_id\nWHERE t.work_id=:work AND t.branch_id=CAST(:branch AS uuid) AND o.topic='task.changed'\n AND o.created_at>=:since AND o.created_at<:until\n AND o.payload->>'state' IN ('RESULT_STORED','ACCEPTED','PAUSED','FAILED','CANCELLED')\nORDER BY o.created_at,o.outbox_id LIMIT :fetch\n\"\"\"\n_FENCES = \"\"\"\nSELECT i.task_id::text AS task,i.generation,i.created_at FROM nf_task_inputs i JOIN nf_tasks t USING(task_id)\nWHERE t.work_id=:work AND t.branch_id=CAST(:branch AS uuid) AND i.generation>0 AND i.created_at>=:since AND i.created_at<:until\n AND i.spec->>'state' IN ('READY','PAUSED','STALE','FAILED','BLOCKED')\nORDER BY i.created_at,i.task_id,i.generation LIMIT :fetch\n\"\"\"\n\n\ndef _spend(rows, end):\n    known_tokens, known_cost = [], []\n    for row in rows:\n        if row[\"updated_at\"] < end and row[\"state\"] in {\"SUCCEEDED\", \"FAILED\"}:\n            if row[\"actual_tokens\"] is not None:\n                known_tokens.append(row[\"actual_tokens\"])\n            if row[\"actual_amount\"] is not None:\n                known_cost.append(row[\"actual_amount\"])\n    total = sum(known_cost, Decimal(0))\n    return {\"attempts\":len(rows), \"known_tokens\":sum(known_tokens), \"unknown_token_attempts\":len(rows)-len(known_tokens),\n            \"actual_tokens\":sum(known_tokens) if len(known_tokens)==len(rows) else None,\n            \"known_amount\":format(total, \"f\"), \"unknown_amount_attempts\":len(rows)-len(known_cost),\n            \"actual_amount\":format(total, \"f\") if len(known_cost)==len(rows) else None}\n\n\ndef _review(rows):\n    decisions = {d[\"report\"]: d[\"action\"] for _,d in rows[\"CREATIVE_REVIEW_DECISION\"]}\n    details = [d for _,d in rows[\"CREATIVE_REVIEW_DETAILS\"] if decisions.get(d[\"report\"]) != \"WITHDRAW\"]\n    covered = {draft for d in details for draft in d[\"drafts\"]}\n    produced = {draft for draft,_ in rows[\"NARRATIVE_DRAFT\"]}\n    actionable = {(d[\"report\"],f) for d in details for f in d[\"actionable\"]}\n    fixed = {(d[\"parent\"],f) for d in details if decisions.get(d[\"report\"]) == \"ACCEPT_REVISION\" for f in d[\"edited\"]}\n    layers = Counter(d[\"layer\"] for d in details)\n    errors = {}\n    for arm in (\"BASELINE\",\"TREATMENT\"):\n        labels = [d for _,d in rows[\"CREATIVE_ADAPTIVE_MEASUREMENT\"] if d[\"eligible\"] and d[\"arm\"]==arm]\n        tp,fp,fn = (sum(d[k] for d in labels) for k in (\"tp\",\"fp\",\"fn\"))\n        neg = [d for d in labels if d[\"gold\"]==0]\n        errors[arm] = {\"labeled_heldout_runs\":len(labels), \"false_positives\":fp if labels else None,\n            \"false_negatives\":fn if labels else None,\"false_discovery_rate\":_ratio(fp,fp+tp),\n            \"miss_rate\":_ratio(fn,fn+tp),\"negative_case_false_alarm_rate\":_ratio(sum(d[\"fp\"]>0 for d in neg),len(neg))}\n    return {\"reports\":len(details),\"reports_by_layer\":dict(sorted(layers.items())), \"covered_drafts\":len(covered),\n      \"coverage\":_ratio(len(covered & produced),len(produced)),\"findings_observed\":sum(d[\"finding_count\"] for d in details),\n      \"actionable_findings\":len(actionable),\"reports_with_actionable_findings\":_ratio(sum(bool(d[\"actionable\"]) for d in details),len(details)),\n      \"independently_fixed\":_ratio(len(actionable & fixed),len(actionable)), \"targeted_revisions\":len(rows[\"CREATIVE_REVIEW_REVISION\"]),\n      \"heldout_review_errors\":errors}\n\n\ndef _lifecycle(events, fences):\n    success = defaultdict(list)\n    episodes = {(e[\"task\"],e[\"generation\"]):e[\"created_at\"] for e in fences}\n    durations = defaultdict(list)\n    for e in events:\n        state,episode = e[\"state\"],(e[\"task\"],e[\"generation\"])\n        if state in {\"PAUSED\",\"FAILED\"}:\n            episodes.setdefault(episode,e[\"created_at\"])\n        if state in {\"RESULT_STORED\",\"ACCEPTED\"}:\n            success[e[\"task\"]].append((e[\"generation\"],e[\"created_at\"]))\n        if state in {\"ACCEPTED\",\"FAILED\",\"CANCELLED\"}:\n            durations[state].append((e[\"created_at\"]-e[\"started\"]).total_seconds()*1000)\n    recovered = sum(any(new_gen>=gen and done>failure for new_gen,done in success[task])\n                    for (task,gen),failure in episodes.items())\n    terminal = [ms for group in durations.values() for ms in group]\n    return ({\"terminal_ms\":_distribution(terminal), \"by_terminal_state_ms\":{k:_distribution(v) for k,v in sorted(durations.items())}},\n            {\"failed_or_fenced_generations\":len(episodes),\"success_after_failure\":_ratio(recovered,len(episodes))})\n\n\nclass CreativeMetricsService:\n    def __init__(self, kernel):\n        self.kernel = kernel\n\n    def report(self, principal, world_ref, *, since=None, until=None, limit=1000):\n        wr = validate_contract(\"WorldRef\",world_ref)\n        require(type(limit) is int and 1<=limit<=5000,\"INVALID_ARGUMENT\",\"Metric row limit must be between 1 and 5000\")\n        requested_start, requested_end = _time(since), _time(until)\n        with self.kernel.db.uow(write=False,repeatable_read=True) as repo:\n            grant = self.kernel.authorize(repo,principal,wr[\"work_id\"],\"ADMIN\",wr[\"branch_id\"])\n            require(grant[\"role_id\"]==\"control_operator\",\"VIEW_DENIED\",\"Metrics require the branch controller\")\n            require(repo.one(\"revisions\",wr,limit=1) if False else repo.conn.scalar(text(\n                \"SELECT 1 FROM nf_revisions WHERE work_id=:work_id AND branch_id=:branch_id AND world_revision_id=:world_revision_id\"), wr),\n                \"VIEW_DENIED\",\"Unknown world revision\")\n            now = repo.now()\n            end = requested_end or now\n            start = requested_start or (end-timedelta(days=1))\n            require(start < end <= now and end-start<=timedelta(days=31),\"INVALID_ARGUMENT\",\n                    \"Choose a completed, nonempty observation interval of at most 31 days\")\n            params = {\"work\":wr[\"work_id\"],\"branch\":wr[\"branch_id\"],\"since\":start,\"until\":end,\n                      \"fetch\":limit+1,\"kinds\":list(_KINDS)}\n            artifacts = _rows(repo,_ARTIFACTS,params)\n            rows = defaultdict(list)\n            for a in artifacts:\n                rows[a[\"kind\"]].append((a[\"id\"],a[\"data\"]))\n            runs = [r for _,r in rows[\"CREATIVE_SIMULATION_RUN\"]]\n            decision_rows = _rows(repo,_DECISIONS,{**params,\"candidates\":[r[\"candidate\"] for r in runs]}) if runs else []\n            calls = _rows(repo,_CALLS,params)\n            events = _rows(repo,_TASK_EVENTS,params)\n            fences = _rows(repo,_FENCES,params)\n            compiled = _rows(repo,\"\"\"SELECT duration_ms FROM nf_audit_events WHERE work_id=:work\n                AND branch_id=CAST(:branch AS uuid) AND event_type='context.compiled'\n                AND event_time>=:since AND event_time<:until ORDER BY event_time,event_id LIMIT :fetch\"\"\",params)\n\n        decisions = {r[\"candidate\"]:r for r in decision_rows}\n        adopted=abandoned=pending=0\n        for r in runs:\n            decision=decisions.get(r[\"candidate\"])\n            for option in r[\"options\"]:\n                if decision is None:\n                    pending+=1\n                elif option==decision[\"option_id\"]:\n                    adopted+=1\n                else:\n                    abandoned+=1\n        packets = [s for _,s in rows[\"CREATIVE_CONTEXT_SNAPSHOT\"]]\n        skill_count = Counter()\n        model_latency = defaultdict(list)\n        seen_attempts = set()\n        for _,call in rows[\"AGENT_CALL_EVIDENCE\"]:\n            if call[\"attempt\"] in seen_attempts:\n                continue\n            seen_attempts.add(call[\"attempt\"])\n            model_latency[call[\"execution_kind\"]].append(call[\"ms\"])\n            skill_count[(call[\"skill\"],call[\"version\"],call[\"dynamic_revision\"],call[\"dynamic_content\"])]+=1\n        by_scene = defaultdict(list)\n        for call in calls:\n            by_scene[(call[\"scene\"],call[\"currency\"])].append(call)\n        scene_costs = [{\"scene_id\":scene,\"currency\":currency,**_spend(population,end)} for (scene,currency),population\n                       in sorted(by_scene.items(),key=lambda x: (x[0][0] or \"\",x[0][1]))]\n        latency,recovery = _lifecycle(events,fences)\n        latency[\"model_call_ms_by_execution_kind\"]={kind:_distribution(group) for kind,group in sorted(model_latency.items())}\n        release_actions = Counter(d[\"decision\"] for _,d in rows[\"CREATIVE_INSTRUCTION_DECISION\"])\n        dynamic_actions = Counter(d[\"action\"] for _,d in rows[\"CREATIVE_DYNAMIC_EVENT\"])\n        engineering = [d for _,d in rows[\"CREATIVE_ADAPTIVE_ENGINEERING_REPORT\"]]\n        return {\"schema_version\":\"1.0\",\"world_ref\":wr,\"coverage\":{\"since\":start.isoformat(),\"until\":end.isoformat(),\n                    \"scope\":\"WORK_BRANCH_EVENT_WINDOW\",\"per_source_limit\":limit,\"complete\":True,\"source_rows\":{\n                        \"artifacts\":len(artifacts),\"call_attempts\":len(calls),\"task_events\":len(events),\"generation_fences\":len(fences),\n                        \"context_compile_events\":len(compiled)}},\n                \"context\":{\"packets\":len(packets),\"compile_ms\":_distribution(c[\"duration_ms\"] for c in compiled),\n                           \"packet_build_ms\":_distribution(p[\"ms\"] for p in packets),\"model_input_bytes\":_distribution(p[\"input_bytes\"] for p in packets),\n                           \"stored_snapshot_bytes\":_distribution(p[\"snapshot_bytes\"] for p in packets),\n                           \"loaded_sources\":_distribution(p[\"sources\"] for p in packets)},\n                \"planning\":{\"candidates\":len(rows[\"CREATIVE_PLAN_CANDIDATE\"]),\"alternatives\":sum(p[\"alternatives\"] for _,p in rows[\"CREATIVE_PLAN_CANDIDATE\"]),\n                            \"decision_counts\":dict(Counter(d[\"status\"] for _,d in rows[\"CREATIVE_PLAN_DECISION\"])),\n                            \"simulations\":len(runs),\"simulated_paths\":adopted+abandoned+pending,\"pending_paths\":pending,\n                            \"adoption\":_ratio(adopted,adopted+abandoned),\"abandonment\":_ratio(abandoned,adopted+abandoned)},\n                \"review\":_review(rows),\"dynamic\":{\"instances_created\":len(rows[\"CREATIVE_DYNAMIC_INSTANCE\"]),\"actions\":dict(sorted(dynamic_actions.items())),\n                    \"dispatched_skill_versions\":[{\"skill\":skill,\"static_version\":version,\"dynamic_revision_id\":revision,\n                    \"dynamic_content_sha256\":digest,\"calls\":n} for (skill,version,revision,digest),n in sorted(skill_count.items(),key=lambda x: tuple(v or \"\" for v in x[0]))]},\n                \"instructions\":{\"proposed\":len(rows[\"CREATIVE_INSTRUCTION_CANDIDATE\"]),\"evaluated\":len(engineering),\n                    \"complete\":sum(d[\"status\"]==\"COMPLETE\" for d in engineering),\"eligible\":sum(bool(d[\"eligible\"]) for d in engineering),\n                    \"promoted\":release_actions[\"APPROVE\"],\"rejected\":release_actions[\"REJECT\"],\"rolled_back\":release_actions[\"ROLLBACK\"]},\n                \"scenes\":scene_costs,\"latency\":latency,\"recovery\":recovery}\n")
format_files(m)
s=m.read_text().replace('("BASELINE", "TREATMENT")','("CONTROL", "TREATMENT")').replace('repo.one("revisions", wr, limit=1)\n                if False\n                else repo.conn.scalar(', 'repo.conn.scalar(')
m.write_text(s)
t.write_text("import json\nfrom datetime import UTC, datetime, timedelta\n\nimport pytest\nfrom test_adaptive_promotion import enroll_case, release_case\nfrom test_harness_dynamic_registry import delegated_site, setup\nfrom test_harness_planning_simulation import decide, propose, scene, simulate\n\nfrom novel_factory.application.creative_metrics import CreativeMetricsService\nfrom novel_factory.domain.errors import DomainError\nfrom novel_factory.fixtures import load_fixture\n\npytestmark = [pytest.mark.integration,pytest.mark.postgres]\n\n\ndef test_planning_ratios_count_only_executed_paths_and_keep_pending(scene):\n    s = scene\n    service = CreativeMetricsService(s[\"kernel\"])\n    def see(**args):\n        return service.report(s[\"owner\"],s[\"wr\"],**args)\n    candidate = propose(s)\n    run = simulate(s,candidate)\n    ids = [p[\"option_id\"] for p in run[\"stops\"] if p[\"steps\"]>0]\n    assert len(ids)==2\n    before = see()\n    assert before[\"planning\"][\"pending_paths\"]==len(ids)\n    assert before[\"planning\"][\"adoption\"][\"rate\"] is None\n    for arm in before[\"review\"][\"heldout_review_errors\"].values():\n        assert arm[\"false_negatives\"] is None and arm[\"false_positives\"] is None\n    decide(s,candidate,ids[0],\"adopt-first\")\n    observed = see()\n    assert observed[\"planning\"][\"adoption\"] == {\"numerator\":1,\"denominator\":2,\"rate\":.5}\n    assert observed[\"planning\"][\"abandonment\"] == observed[\"planning\"][\"adoption\"]\n    assert observed[\"planning\"][\"candidates\"]==1 and observed[\"planning\"][\"alternatives\"]>=2\n    assert observed[\"latency\"][\"terminal_ms\"][\"p95\"] is None\n    assert \"conditional_result\" not in json.dumps(observed) and 'believed_by' not in json.dumps(observed)\n    with pytest.raises(DomainError, match=\"row limit\"):\n        see(limit=1)\n    with pytest.raises(DomainError):\n        service.report(s[\"actors\"][0].principal,s[\"wr\"])\n    other = load_fixture(s[\"kernel\"])\n    with pytest.raises(DomainError):\n        service.report(s[\"owner\"],other[\"world_ref\"])\n    sibling = s[\"kernel\"].fork(s[\"owner\"],s[\"wr\"],\"CANDIDATE\",\"metrics-empty\")\n    assert service.report(s[\"owner\"],sibling)[\"planning\"][\"candidates\"]==0\n    with pytest.raises(DomainError):\n        see(since=\"2025-03-01\",until=\"2025-03-02\")\n    with pytest.raises(DomainError):\n        see(since=\"2025-01-01T00:00:00Z\",until=\"2025-04-01T00:00:00Z\")\n\n\ndef test_real_s5_run_and_signed_native_review_population(kernel_env,tmp_path,monkeypatch):\n    k = kernel_env[\"kernel\"]\n    s = release_case(k,tmp_path,monkeypatch)\n    m = CreativeMetricsService(k)\n    def see():\n        return m.report(s[\"admin\"],s[\"wr\"])\n    earlier = see()\n    assert earlier[\"instructions\"][\"complete\"]==1 and earlier[\"instructions\"][\"eligible\"]==1\n    assert earlier[\"instructions\"][\"promoted\"] == earlier[\"instructions\"][\"rolled_back\"] == 0\n    assert earlier[\"review\"][\"coverage\"][\"rate\"]==1\n    errors = earlier[\"review\"][\"heldout_review_errors\"]\n    assert errors[\"CONTROL\"][\"false_negatives\"] > errors[\"TREATMENT\"][\"false_negatives\"] == 0\n    assert errors[\"TREATMENT\"][\"false_positives\"]==0 and errors[\"TREATMENT\"][\"negative_case_false_alarm_rate\"][\"denominator\"]>=1\n    assert earlier[\"latency\"][\"by_terminal_state_ms\"][\"ACCEPTED\"][\"n\"]>=4\n    refs,pub,svc = s[\"refs\"],s[\"publisher\"],s[\"service\"]\n    deadline=(datetime.now(UTC)+timedelta(minutes=5)).isoformat()\n    enroll_case(s,tmp_path)\n    op=svc.review(s[\"reviewer\"].principal,s[\"wr\"],**refs,**s[\"job\"],publisher_grant_id=pub.grant_id,\n                 verdict=\"APPROVE\",reason=\"独立留出样本支持。\",valid_until=deadline,idempotency_key=\"metric-op\")\n    change=svc.decide(pub,s[\"wr\"],**refs,review_ref=op[\"review_ref\"],action=\"APPROVE\",expected_epoch=0,\n                      reason=\"留出核验通过。\",valid_until=deadline,idempotency_key=\"metric-release\")\n    svc.rollback(pub,s[\"wr\"],decision_ref=change[\"decision_ref\"],expected_epoch=1,\n                 reason=\"恢复原指令。\",idempotency_key=\"metric-back\")\n    new = see()\n    assert new[\"instructions\"][\"promoted\"] == new[\"instructions\"][\"rolled_back\"] == 1\n    assert new[\"review\"][\"independently_fixed\"][\"numerator\"]==0\n\n\ndef test_scoped_dynamic_instance_count_distinguishes_versions(setup):\n    k,wr,owner,source,svc,args,_ = setup\n    a=svc.register_revision(owner,*source,**args(0))\n    svc.register_revision(owner,*source,**args(1))\n    svc.select(owner,wr,instance_ref=a[\"instance_ref\"],revision_ref=a[\"revision_ref\"],expected_epoch=0,idempotency_key=\"metric-select\")\n    report=CreativeMetricsService(k).report(owner,wr)\n    assert report[\"dynamic\"][\"instances_created\"]==1\n    assert sum(report[\"dynamic\"][\"actions\"].values())==1\n    assert not report[\"dynamic\"][\"dispatched_skill_versions\"]\n")
