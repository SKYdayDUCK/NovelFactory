for f,count in ((m,500),(t,381)):
    data=f.read_bytes()
    digest=hashlib.sha1(b'blob '+str(len(data)).encode()+b'\0'+data).hexdigest()
    print(f, len(data.splitlines()),len(data),digest)
    assert len(data.splitlines())==count, "Reconstruction differs from previously observed staged line count"
