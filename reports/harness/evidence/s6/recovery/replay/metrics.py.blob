a=s.index('def _spend('); b=s.index('    total = sum(known_cost, Decimal(0))',a)
s=s[:a]+'''def _spend(rows, end, audits):
    known_tokens, known_cost = [], []
    provider_measured = 0
    for row in rows:
        audit = audits.get(row["attempt"], {})
        settled = row["updated_at"] < end and row["state"] in {"SUCCEEDED", "FAILED"}
        if settled and row["actual_tokens"] is not None:
            known_tokens.append(row["actual_tokens"])
        elif audit.get("input_tokens") is not None and audit.get("output_tokens") is not None:
            known_tokens.append(audit["input_tokens"] + audit["output_tokens"])
            provider_measured += 1
        if settled and row["actual_amount"] is not None:
            known_cost.append(row["actual_amount"])
'''+s[b:]
s=s.replace('"known_tokens": sum(known_tokens),','"known_tokens": sum(known_tokens),\n        "tokens_from_unsettled_provider_receipts": provider_measured,')
s=s.replace('"""SELECT duration_ms FROM nf_audit_events WHERE work_id=:work','"""SELECT duration_ms,harness_details->\'packet_bytes\' AS compiled_bytes FROM nf_audit_events WHERE work_id=:work')
s=s.replace('        seen_attempts = set()','        audits = {}')
s=s.replace('if call["attempt"] in seen_attempts:','if call["attempt"] in audits:').replace('seen_attempts.add(call["attempt"])','audits[call["attempt"]] = call\n            provenance = call["execution_kind"]\n            if call["fixture"] or call["loopback"]:\n                provenance = "TEST_FIXTURE" if call["fixture"] else "LOOPBACK_OR_TEST_ENDPOINT"\n            call["origin"] = provenance')
s=s.replace('model_latency[call["execution_kind"]]', 'model_latency[call["origin"]]')
s=s.replace('call["dynamic_revision"], call["dynamic_content"]','call["dynamic_revision"], _version(call["source_revision"]), call["dynamic_content"]')
s=s.replace('by_scene[(call["scene"], call["currency"])]','by_scene[(call["scene"], call["currency"], audits.get(call["attempt"], {}).get("origin","UNCLASSIFIED_LEDGER"))]')
s=s.replace('{"scene_id": scene, "currency": currency, **_spend(population, end)}','{"scene_id": scene, "currency": currency, "execution_origin":origin, **_spend(population, end, audits)}')
s=s.replace('for (scene, currency), population','for (scene, currency, origin), population').replace('(x[0][0] or "", x[0][1])','(x[0][0] or "", *x[0][1:])')
s=s.replace('"dynamic_content_sha256": digest,','"dynamic_source_revision": source_version,\n                        "dynamic_content_sha256": digest,').replace('(skill, version, revision, digest), n','(skill, version, revision, source_version, digest), n')
s=s.replace('"compile_ms": _distribution(c["duration_ms"] for c in compiled),','"compile_ms": _distribution(c["duration_ms"] for c in compiled),\n                "compiled_bytes": _distribution(c["compiled_bytes"] for c in compiled),')
